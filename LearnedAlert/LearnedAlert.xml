<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\FrameXML\UI.xsd">
	<Script file="config.lua"/>
	<Script file="utils.lua"/>
	<Script file="locale.lua"/>
	<Script file="core.lua"/>

	<!-- shared by both looks -->
	<Button name="LearnedAlertButtonScriptsTemplate" virtual="true">
		<Scripts>
			<OnLoad function="LearnedAlertButtonTemplate_OnLoad"/>
			<OnShow function="LearnedAlertButtonTemplate_OnShow"/>
			<OnHide function="LearnedAlertButtonTemplate_OnHide"/>
			<OnClick function="LearnedAlertButtonTemplate_OnClick"/>
			<OnEnter function="LearnedAlertButtonTemplate_OnEnter"/>
			<OnLeave function="GameTooltip_Hide"/>
		</Scripts>
	</Button>

	<!-- without DragonUI: the stock achievement alert (FrameXML AlertFrames.xml, AchievementAlertFrameTemplate) -->
	<Button name="LearnedAlertButtonTemplate" inherits="LearnedAlertButtonScriptsTemplate" parent="UIParent" toplevel="true" frameLevel="120" frameStrata="FULLSCREEN_DIALOG" hidden="true" virtual="true">
		<Size x="300" y="88"/>
		<Animations>
			<AnimationGroup parentKey="animIn">
				<Alpha change="-1" duration="0" order="1"/>
				<Alpha change="1" duration="0.2" order="2"/>
				<Scripts>
					<OnFinished>
						self:GetParent().waitAndAnimOut:Play()
					</OnFinished>
				</Scripts>
			</AnimationGroup>
			<AnimationGroup parentKey="waitAndAnimOut">
				<Alpha startDelay="4.05" change="-1" duration="1.5" parentKey="animOut">
					<Scripts>
						<OnFinished>
							self:GetParent():GetParent():Hide()
						</OnFinished>
					</Scripts>
				</Alpha>
			</AnimationGroup>
		</Animations>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" file="Interface\AchievementFrame\UI-Achievement-Alert-Background">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<TexCoords left="0" right="0.605" top="0" bottom="0.703"/>
				</Texture>
				<FontString parentKey="Label" inherits="GameFontBlackTiny">
					<Size x="200" y="12"/>
					<Anchors>
						<Anchor point="TOP" x="7" y="-23"/>
					</Anchors>
				</FontString>
				<FontString parentKey="ItemName" inherits="GameFontHighlight" justifyV="MIDDLE">
					<Size x="188" y="28"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="72" y="30"/>
						<Anchor point="BOTTOMRIGHT" x="-40" y="30"/>
					</Anchors>
				</FontString>
			</Layer>
			<!-- the stock alert's AchievementIconFrameTemplate: 50px icon in the gold icon frame -->
			<Layer level="ARTWORK">
				<Texture parentKey="Icon">
					<Size x="50" y="50"/>
					<Anchors>
						<Anchor point="CENTER" relativePoint="TOPLEFT" x="36" y="-43"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="IconBorder" file="Interface\AchievementFrame\UI-Achievement-IconFrame">
					<Size x="72" y="72"/>
					<Anchors>
						<Anchor point="CENTER" relativePoint="TOPLEFT" x="35" y="-44"/>
					</Anchors>
					<TexCoords left="0" right="0.5625" top="0" bottom="0.5625"/>
				</Texture>
				<Texture parentKey="glow" file="Interface\AchievementFrame\UI-Achievement-Alert-Glow" alphaMode="ADD" alpha="0">
					<Size x="400" y="171"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
					<TexCoords left="0" right="0.78125" top="0" bottom="0.66796875"/>
					<Animations>
						<AnimationGroup parentKey="animIn">
							<Alpha change="1" duration="0.2" order="1"/>
							<Alpha change="-1" duration="0.5" order="2"/>
						</AnimationGroup>
					</Animations>
				</Texture>
				<Texture parentKey="shine" file="Interface\AchievementFrame\UI-Achievement-Alert-Glow" alphaMode="ADD" alpha="0">
					<Size x="67" y="72"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="0" y="8"/>
					</Anchors>
					<TexCoords left="0.78125" right="0.912109375" top="0" bottom="0.28125"/>
					<Animations>
						<AnimationGroup parentKey="animIn">
							<Alpha change="1" duration="0.2" order="1"/>
							<Translation offsetX="240" offsetY="0" duration="0.85" order="2"/>
							<Alpha startDelay="0.35" change="-1" duration="0.5" order="2"/>
						</AnimationGroup>
					</Animations>
				</Texture>
			</Layer>
		</Layers>
	</Button>

	<!-- with DragonUI: the retail loot toast -->
	<Button name="LearnedAlertLootToastTemplate" inherits="LearnedAlertButtonScriptsTemplate" parent="UIParent" toplevel="true" frameLevel="120" frameStrata="FULLSCREEN_DIALOG" hidden="true" virtual="true">
		<Size x="276" y="96"/>
		<Animations>
			<AnimationGroup parentKey="animIn">
				<Alpha change="0" duration="0" order="1"/>
				<Alpha change="1" duration="0.2" order="2"/>
				<Scripts>
					<OnFinished>
						self:GetParent().waitAndAnimOut:Play()
					</OnFinished>
				</Scripts>
			</AnimationGroup>
			<AnimationGroup parentKey="waitAndAnimOut">
				<Alpha startDelay="4.05" change="-1" duration="1.5" parentKey="animOut">
					<Scripts>
						<OnFinished>
							self:GetParent():GetParent():Hide()
						</OnFinished>
					</Scripts>
				</Alpha>
			</AnimationGroup>
		</Animations>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" file="Interface\AddOns\LearnedAlert\assets\loottoast">
					<Size x="276" y="96"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
					<TexCoords left="0.28222656" right="0.55175781" top="0.57812500" bottom="0.95312500"/>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture name="$parentIcon" parentKey="Icon" file="Interface\AddOns\LearnedAlert\assets\unknow_treasure">
					<Size x="52" y="52"/>
					<Anchors>
						<Anchor point="LEFT" x="23" y="-2"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="IconBorder" file="Interface\AddOns\LearnedAlert\assets\LootToastAtlas">
					<Size x="58" y="58"/>
					<Anchors>
						<Anchor point="CENTER" relativeTo="$parentIcon" relativePoint="CENTER" x="0" y="0"/>
					</Anchors>
					<TexCoords left="0.34082" right="0.397461" top="0.882812" bottom="0.996094"/>
				</Texture>
				<FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT">
					<Size x="167" y="16"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentIcon" relativePoint="TOPRIGHT" x="7" y="5"/>
					</Anchors>
				</FontString>
				<FontString parentKey="ItemName" inherits="GameFontNormalMed3" justifyH="LEFT" justifyV="MIDDLE">
					<Size x="167" y="33"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentIcon" relativePoint="TOPRIGHT" x="10" y="-16"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="OVERLAY">
				<Texture file="Interface\AddOns\LearnedAlert\assets\LootToastAtlas" alphaMode="ADD" hidden="true" parentKey="glow">
					<Size x="286" y="109"/>
					<Anchors>
						<Anchor point="CENTER" x="0" y="0"/>
					</Anchors>
					<TexCoords left="0.000976562" right="0.280273" top="0.00195312" bottom="0.214844"/>
					<Animations>
						<AnimationGroup parentKey="animIn">
							<Alpha change="-1" duration="0" order="1"/>
							<Alpha change="1" duration="0.2" order="2"/>
							<Alpha change="-1" duration="0.5" order="3"/>
							<Scripts>
								<OnPlay>
									self:GetParent():Show()
								</OnPlay>
								<OnFinished>
									self:GetParent():Hide()
								</OnFinished>
							</Scripts>
						</AnimationGroup>
					</Animations>
				</Texture>
				<Texture file="Interface\AddOns\LearnedAlert\assets\LootToastAtlas" alphaMode="ADD" hidden="true" parentKey="shine">
					<Size x="171" y="75"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="-10" y="12"/>
					</Anchors>
					<TexCoords left="0.817383" right="0.984375" top="0.21875" bottom="0.365234"/>
					<Animations>
						<AnimationGroup parentKey="animIn">
							<Alpha change="-1" duration="0" order="1"/>
							<Alpha change="1" duration="0.1" order="2"/>
							<Translation offsetX="200" offsetY="0" duration="0.71" order="3"/>
							<Alpha change="-1" duration="0.25" startDelay="0.175" order="3"/>
							<Scripts>
								<OnPlay>
									self:GetParent():Show()
								</OnPlay>
								<OnFinished>
									self:GetParent():Hide()
								</OnFinished>
							</Scripts>
						</AnimationGroup>
					</Animations>
				</Texture>
			</Layer>
		</Layers>
	</Button>

	<Frame name="LearnedAlertFrame" parent="UIParent" hidden="false">
		<Size x="10" y="10"/>
		<Anchors>
			<Anchor point="BOTTOM" x="0" y="128"/>
		</Anchors>
		<Scripts>
			<OnLoad function="LearnedAlertFrame_OnLoad"/>
			<OnEvent function="LearnedAlertFrame_OnEvent"/>
			<OnUpdate function="LearnedAlertFrame_OnUpdate"/>
		</Scripts>
	</Frame>
</Ui>
